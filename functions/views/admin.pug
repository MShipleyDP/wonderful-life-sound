      // Rebuild Flagged Items
      async function rebuildFlaggedItems(deleteFlags) {
        try {
          const response = await fetch('/admin/data');
          const data = await response.json();
          const soundData = data.soundData || {};

          console.log('Rebuilding flagged items...');
          console.log('Delete flags:', deleteFlags);
          console.log('Sound categories:', Object.keys(soundData));

          const flaggedFiles = [];
          Object.keys(deleteFlags).forEach(fileId => {
            console.log('Processing fileId:', fileId);

            // Find which category this fileId belongs to
            // by checking if fileId starts with any category key
            let matchedCategoryKey = null;
            let filenameWithoutExt = null;

            for (const catKey of Object.keys(soundData)) {
              if (fileId.startsWith(catKey + '_')) {
                matchedCategoryKey = catKey;
                filenameWithoutExt = fileId.substring(catKey.length + 1);
                break;
              }
            }

            if (!matchedCategoryKey) {
              console.log('  ❌ No matching category found');
              return;
            }

            console.log('  Category:', matchedCategoryKey, 'Filename:', filenameWithoutExt);

            const category = soundData[matchedCategoryKey];
            if (!category) {
              console.log('  ❌ Category not found');
              return;
            }
            if (!category.files) {
              console.log('  ❌ Category has no files');
              return;
            }

            console.log('  Category has', category.files.length, 'files');

            const file = category.files.find(f => {
              const fname = f.filename || f;
              const fnameWithoutExt = fname.replace(/\.[^/.]+$/, '');
              const match = fnameWithoutExt === filenameWithoutExt;
              if (match) {
                console.log('  ✅ Found file:', fname);
              }
              return match;
            });

            if (file) {
              const filename = file.filename || file;
              flaggedFiles.push({
                category: category.title,
                categoryKey: matchedCategoryKey,
                filename: filename,
                fileId: fileId,
                url: file.url || `${matchedCategoryKey}/${filename}`
              });
            } else {
              console.log('  ❌ File not found in category');
            }
          });

          console.log('Total flagged files found:', flaggedFiles.length);

          // Find or create flagged content container
          const libraryFlagged = document.getElementById('library-flagged');
          if (!libraryFlagged) return;

          let html = '';
          if (flaggedFiles.length > 0) {
            html = `
              <div class="section">
                <h2>🗑️ Flagged for Deletion</h2>
                <p style="margin-bottom: var(--space-3); color: var(--color-danger); font-weight: bold;">${flaggedFiles.length} file(s) flagged for deletion</p>
                <div style="display: flex; gap: var(--space-2); margin-bottom: var(--space-4);">
                  <button class="btn btn-danger" onclick="deleteAllFlagged()">Delete All ${flaggedFiles.length} Flagged Files</button>
                  <button class="btn btn-primary" onclick="cleanupOrphanedFlags()" title="Remove delete flags for files that no longer exist">🧹 Clean Up Orphaned Flags</button>
                </div>
                <div class="sound-list">
                  ${flaggedFiles.map(flagged => `
                    <div class="sound-item" style="border-left-color: var(--color-danger); border-left-width: 3px;" data-file-id="${flagged.fileId}">
                      <div class="sound-info">
                        <strong>${flagged.category} / ${flagged.filename}</strong>
                        <small style="color: #999; font-family: 'Courier New', monospace;">ID: ${flagged.fileId}</small>
                        ${flagged.url ? `
                          <audio class="admin-audio" controls preload="none">
                            <source src="${flagged.url}" type="audio/mpeg">
                          </audio>
                        ` : ''}
                      </div>
                      <div>
                        <button class="btn btn-danger" onclick="deleteFlaggedSound('${flagged.categoryKey}', '${flagged.filename}', '${flagged.fileId}')" style="margin-right: var(--space-2);">Delete</button>
                        <button class="btn btn-primary" onclick="unflagSound('${flagged.fileId}')">Unflag</button>
                      </div>
                    </div>
                  `).join('')}
                </div>
              </div>
            `;
          } else {
            html = `
              <div class="section">
                <h2>🗑️ Flagged for Deletion</h2>
                <p style="color: var(--color-text-muted); text-align: center; padding: var(--space-8);">No files flagged for deletion.</p>
                <div style="text-align: center; margin-top: var(--space-4);">
                  <button class="btn btn-primary" onclick="cleanupOrphanedFlags()" title="Remove delete flags for files that no longer exist">🧹 Clean Up Orphaned Flags</button>
                  <p style="color: var(--color-text-muted); font-size: 0.875rem; margin-top: var(--space-2);">Use this if you see phantom files flagged in the app but not here</p>
                </div>
              </div>
            `;
          }

          libraryFlagged.innerHTML = html;
        } catch (error) {
          console.error('Error rebuilding flagged items:', error);
        }
      }

