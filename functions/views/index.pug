      // Setup real-time listeners for changes from other users
      function setupRealTimeListeners() {
        // Initialize Firebase
        const firebaseConfig = {
          databaseURL: 'https://wonderful-life-sound-default-rtdb.firebaseio.com',
          projectId: 'wonderful-life-sound'
        };

        if (!firebase.apps.length) {
          firebase.initializeApp(firebaseConfig);
        }

        const db = firebase.database();

        // Store previous state to detect actual changes
        let previousFavorites = {};
        let previousRatings = {};
        let previousNotes = {};
        let previousDeleteFlags = {};
        let isInitialLoad = true;

        // Listen to all favorites with value listener for reliable updates
        db.ref('selections/favorites').on('value', (snapshot) => {
          const currentFavorites = {};
          const data = snapshot.val() || {};

          // Build current state from database
          Object.keys(data).forEach(category => {
            Object.keys(data[category]).forEach(encodedFilename => {
              const item = data[category][encodedFilename];
              const key = `${item.category}:${item.file}`;
              currentFavorites[key] = true;
            });
          });

          if (!isInitialLoad) {
            // Check for added favorites
            Object.keys(currentFavorites).forEach(key => {
              if (!previousFavorites[key]) {
                const [category, ...filenameParts] = key.split(':');
                const filename = filenameParts.join(':');
                updateFavoriteUI(category, filename, true);
              }
            });

            // Check for removed favorites
            Object.keys(previousFavorites).forEach(key => {
              if (!currentFavorites[key]) {
                const [category, ...filenameParts] = key.split(':');
                const filename = filenameParts.join(':');
                updateFavoriteUI(category, filename, false);
              }
            });
          }

          previousFavorites = currentFavorites;
        });

        // Listen to all ratings with value listener for reliable updates
        db.ref('selections/ratings').on('value', (snapshot) => {
          const currentRatings = {};
          const data = snapshot.val() || {};

          // Build current state from database
          Object.keys(data).forEach(ratingKey => {
            const item = data[ratingKey];
            const key = `${item.category}:${item.filename}`;
            currentRatings[key] = item.rating;
          });

          if (!isInitialLoad) {
            // Check for changed or added ratings
            Object.keys(currentRatings).forEach(key => {
              if (previousRatings[key] !== currentRatings[key]) {
                const [category, ...filenameParts] = key.split(':');
                const filename = filenameParts.join(':');
                updateRatingUI(category, filename, currentRatings[key]);
              }
            });

            // Check for removed ratings
            Object.keys(previousRatings).forEach(key => {
              if (!(key in currentRatings)) {
                const [category, ...filenameParts] = key.split(':');
                const filename = filenameParts.join(':');
                updateRatingUI(category, filename, 0);
              }
            });
          }

          previousRatings = currentRatings;
        });

        // Listen to all notes with value listener for reliable updates
        db.ref('selections/notes').on('value', (snapshot) => {
          const currentNotes = snapshot.val() || {};

          if (!isInitialLoad) {
            // Check for changed or added notes
            Object.keys(currentNotes).forEach(category => {
              const newNotes = currentNotes[category].notes || '';
              const oldNotes = previousNotes[category] || '';
              if (newNotes !== oldNotes) {
                updateNoteUI(category, newNotes);
              }
            });

            // Check for removed notes
            Object.keys(previousNotes).forEach(category => {
              if (!(category in currentNotes)) {
                updateNoteUI(category, '');
              }
            });
          }

          // Build current state
          const notesState = {};
          Object.keys(currentNotes).forEach(category => {
            notesState[category] = currentNotes[category].notes || '';
          });
          previousNotes = notesState;
        });

        // Listen to all delete flags with value listener for reliable updates
        db.ref('selections/deleteFlags').on('value', (snapshot) => {
          const currentDeleteFlags = snapshot.val() || {};

          if (!isInitialLoad) {
            // Check for changed or added delete flags
            Object.keys(currentDeleteFlags).forEach(fileId => {
              const newFlag = currentDeleteFlags[fileId];
              const oldFlag = previousDeleteFlags[fileId];
              if (JSON.stringify(newFlag) !== JSON.stringify(oldFlag)) {
                updateDeleteFlagUI(newFlag.category, newFlag.filename, fileId, newFlag.isFlagged);
              }
            });

            // Check for removed delete flags
            Object.keys(previousDeleteFlags).forEach(fileId => {
              if (!(fileId in currentDeleteFlags)) {
                const oldFlag = previousDeleteFlags[fileId];
                updateDeleteFlagUI(oldFlag.category, oldFlag.filename, fileId, false);
              }
            });
          }

          previousDeleteFlags = currentDeleteFlags;
        });

        // Listen to sound files for deletions
        db.ref('sounds').on('value', (snapshot) => {
          if (isInitialLoad) return;

          const newSoundData = snapshot.val() || {};

          // Check for deleted files by comparing with the current DOM
          document.querySelectorAll('.sound-file').forEach(soundFileEl => {
            const category = soundFileEl.dataset.category;
            const filename = soundFileEl.dataset.file;

            // Check if this file still exists in the database
            const categoryData = newSoundData[category];
            if (!categoryData || !categoryData.files) {
              // Category deleted, remove the file
              removeFileFromUI(category, filename);
              return;
            }

            const fileExists = categoryData.files.some(f => {
              const fname = f.filename || f;
              return fname === filename;
            });

            if (!fileExists) {
              // File was deleted, remove from UI
              removeFileFromUI(category, filename);
            }
          });

          // Update file counts for all categories
          Object.keys(newSoundData).forEach(categoryKey => {
            updateCategoryCounts(categoryKey);

            // Update category header count
            const categoryCount = document.querySelector(`.category[data-category-key="${categoryKey}"] .category-count`);
            if (categoryCount) {
              const fileCount = newSoundData[categoryKey].files ? newSoundData[categoryKey].files.length : 0;
              categoryCount.textContent = `${fileCount} file${fileCount !== 1 ? 's' : ''}`;
            }
          });
        });

        // Mark initial load as complete after a short delay
        setTimeout(() => {
          isInitialLoad = false;
          console.log('Real-time sync active - monitoring for changes');
        }, 1000);
      }

      // Remove file from UI when deleted
      function removeFileFromUI(category, filename) {
        const soundFile = document.querySelector(
          `.sound-file[data-category="${category}"][data-file="${filename}"]`
        );
        if (soundFile) {
          // Fade out animation
          soundFile.style.transition = 'opacity 0.3s, transform 0.3s';
          soundFile.style.opacity = '0';
          soundFile.style.transform = 'scale(0.9)';

          setTimeout(() => {
            soundFile.remove();
            console.log(`File removed from UI: ${category}/${filename}`);
            updateCategoryCounts(category);
          }, 300);
        }
      }

      // Update category counts in sidebar
      function updateCategoryCounts(categoryKey) {
        const navLink = document.querySelector(`.sidebar nav a[data-category="${categoryKey}"]`);
        if (!navLink) return;

        const countContainer = navLink.querySelector('.count');
        if (!countContainer) return;

        // Count files in this category
        const categoryEl = document.querySelector(`.category[data-category-key="${categoryKey}"]`);
        if (!categoryEl) return;

        const allFiles = categoryEl.querySelectorAll('.sound-file');
        const checkedFiles = categoryEl.querySelectorAll('.sound-file .favorite-checkbox:checked');
        const flaggedFiles = categoryEl.querySelectorAll('.sound-file .delete-flag.flagged');

        const total = allFiles.length;
        const checked = checkedFiles.length;
        const flagged = flaggedFiles.length;

        // Check if there are notes
        const notesTextarea = document.getElementById(`${categoryKey}-notes`);
        const hasNotes = notesTextarea && notesTextarea.value.trim().length > 0;

        // Update data attributes
        countContainer.setAttribute('data-total', total);
        countContainer.setAttribute('data-checked', checked);
        countContainer.setAttribute('data-flagged', flagged);
        countContainer.setAttribute('data-has-notes', hasNotes ? 'true' : 'false');

        // Update display
        let html = `<span class="count-main">${total}</span>`;
        if (checked > 0 || flagged > 0 || hasNotes) {
          html += '<span class="count-details">';
          if (checked > 0) {
            html += `✓${checked}`;
          }
          if (checked > 0 && (flagged > 0 || hasNotes)) {
            html += ' • ';
          }
          if (flagged > 0) {
            html += `🗑${flagged}`;
          }
          if (flagged > 0 && hasNotes) {
            html += ' • ';
          }
          if (hasNotes) {
            html += '📝';
          }
          html += '</span>';
        }

        countContainer.innerHTML = html;
      }

      // Update favorite UI from real-time event
      function updateFavoriteUI(category, filename, isFavorite) {
        const key = `${category}:${filename}`;
        const pending = pendingSaves.favorites.get(key);

        // Don't update if there's a pending save with different state
        // This prevents real-time updates from reverting local changes
        if (pending && pending.isFavorite !== isFavorite) {
          console.log('Skipping favorite UI update - pending save in progress');
          return;
        }

        const soundFile = document.querySelector(
          `.sound-file[data-category="${category}"][data-file="${filename}"]`
        );
        if (soundFile) {
          const checkbox = soundFile.querySelector('.favorite-checkbox');
          checkbox.checked = isFavorite;
          if (isFavorite) {
            soundFile.classList.add('selected');
          } else {
            soundFile.classList.remove('selected');
          }
          // Update category counts
          updateCategoryCounts(category);
        }
      }

      // Update rating UI from real-time event
      function updateRatingUI(category, filename, rating) {
        const key = `${category}:${filename}`;
        const pending = pendingSaves.ratings.get(key);

        // Don't update if there's a pending save with different state
        // This prevents real-time updates from reverting local changes
        if (pending && pending.rating !== rating) {
          console.log('Skipping rating UI update - pending save in progress');
          return;
        }

        const soundFile = document.querySelector(
          `.sound-file[data-category="${category}"][data-file="${filename}"]`
        );
        if (soundFile) {
          const container = soundFile.querySelector('.rating-stars');
          const stars = container.querySelectorAll('.star');
          container.setAttribute('data-rating', rating);
          stars.forEach((star, index) => {
            if (index < rating) {
              star.classList.add('active');
              star.setAttribute('aria-checked', 'true');
            } else {
              star.classList.remove('active');
              star.setAttribute('aria-checked', 'false');
            }
          });
        }
      }

      // Update note UI from real-time event
      function updateNoteUI(category, notes) {
        const textarea = document.getElementById(`${category}-notes`);
        if (textarea && document.activeElement !== textarea) {
          // Only update if user is not currently typing in this textarea
          textarea.value = notes;
          // Update category counts to show/hide note indicator
          updateCategoryCounts(category);
        }
      }

      // Update delete flag UI from real-time event
      function updateDeleteFlagUI(category, filename, fileId, isFlagged) {
        const pending = pendingSaves.deleteFlags.get(fileId);

        // Don't update if there's a pending save with different state
        if (pending && pending.isFlagged !== isFlagged) {
          console.log('Skipping delete flag UI update - pending save in progress');
          return;
        }

        const soundFile = document.querySelector(
          `.sound-file[data-category="${category}"][data-file="${filename}"]`
        );
        if (soundFile) {
          const deleteFlag = soundFile.querySelector('.delete-flag');
          if (isFlagged) {
            deleteFlag.classList.add('flagged');
            deleteFlag.textContent = '🗑️';
            deleteFlag.title = 'Flagged for deletion - Click to unflag';
            soundFile.classList.add('flagged-for-deletion');
          } else {
            deleteFlag.classList.remove('flagged');
            deleteFlag.textContent = '🗑';
            deleteFlag.title = 'Flag for deletion';
            soundFile.classList.remove('flagged-for-deletion');
          }
          // Update category counts
          updateCategoryCounts(category);
        }
      }

      // Save progress to server
      function saveProgress() {
        const progress = {
          favorites: [],
          ratings: {},
          notes: {}
        };

        // Save favorites
        document.querySelectorAll('.favorite-checkbox:checked').forEach(checkbox => {
          const soundFile = checkbox.closest('.sound-file');
          progress.favorites.push({
            category: soundFile.dataset.category,
            file: soundFile.dataset.file
          });
        });

        // Save ratings
        document.querySelectorAll('.rating-stars').forEach(container => {
          const rating = container.getAttribute('data-rating');
          const soundFile = container.closest('.sound-file');
          if (rating > 0) {
            const key = `${soundFile.dataset.category}/${soundFile.dataset.file}`;
            progress.ratings[key] = rating;
          }
        });

        // Save notes
        document.querySelectorAll('.notes-textarea').forEach(textarea => {
          if (textarea.value.trim()) {
            const category = textarea.id.replace('-notes', '');
            progress.notes[category] = textarea.value;
          }
        });

        // Save to server
        fetch('/api/selections', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json'
          },
          body: JSON.stringify(progress)
        })
        .then(response => response.json())
        .then(data => {
          showStatus(data.message || 'Progress saved to cloud!', false, 'success');
        })
        .catch(error => {
          console.error('Save error:', error);
          showStatus('Error saving progress', true);
        });
      }

      // Export report
      function exportReport() {
        let report = '# IT\'S A WONDERFUL LIFE - SOUND SELECTION REPORT\n\n';
        report += `Generated: ${new Date().toLocaleString()}\n\n`;
        report += '---\n\n';

        Object.keys(soundData).forEach(key => {
          const data = soundData[key];
          report += `## ${data.title}\n`;
          report += `**Director's Original Request:** "${data.directorRequest}"\n`;
          report += `**Description:** ${data.description}\n\n`;

          // Get selected files
          const selected = [];
          document.querySelectorAll(`.sound-file[data-category="${key}"]`).forEach(soundFile => {
            const checkbox = soundFile.querySelector('.favorite-checkbox');
            const ratingContainer = soundFile.querySelector('.rating-stars');
            const rating = ratingContainer.getAttribute('data-rating');
            const fileName = soundFile.dataset.file;

            if (checkbox.checked || rating > 0) {
              let line = `- ${fileName}`;
              if (checkbox.checked) line += ' ✅';
              if (rating > 0) line += ` (${rating}★)`;
              selected.push(line);
            }
          });

          if (selected.length > 0) {
            report += '**Selected Files:**\n';
            report += selected.join('\n') + '\n\n';
          } else {
            report += '*No files selected*\n\n';
          }

          // Get notes
          const textarea = document.getElementById(`${key}-notes`);
          if (textarea && textarea.value.trim()) {
            report += '**Director\'s Notes:**\n';
            report += textarea.value + '\n\n';
          }

          report += '---\n\n';
        });

        // Create downloadable file
        const blob = new Blob([report], { type: 'text/markdown' });
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = 'Sound_Selection_Report.md';
        a.click();

        showStatus('Report exported!', false, 'success');
      }

      // Clear all selections
      function clearAll() {
        if (!confirm('Are you sure you want to clear ALL selections and notes? This cannot be undone.')) {
          return;
        }

        // Clear checkboxes
        document.querySelectorAll('.favorite-checkbox').forEach(cb => {
          cb.checked = false;
        });

        // Clear selected class
        document.querySelectorAll('.sound-file.selected').forEach(sf => {
          sf.classList.remove('selected');
        });

        // Clear ratings
        document.querySelectorAll('.rating-stars').forEach(container => {
          container.setAttribute('data-rating', '0');
          container.querySelectorAll('.star').forEach(star => {
            star.classList.remove('active');
            star.setAttribute('aria-checked', 'false');
          });
        });

        // Clear notes
        document.querySelectorAll('.notes-textarea').forEach(textarea => {
          textarea.value = '';
        });

        // Clear from server
        fetch('/api/selections', {
          method: 'DELETE'
        })
        .then(response => response.json())
        .then(data => {
          showStatus(data.message || 'All selections cleared from cloud!', false, 'success');
        })
        .catch(error => {
          console.error('Clear error:', error);
          showStatus('Error clearing selections', true);
        });
      }

      // Show status message
      function showStatus(message, isError = false, type = 'success') {
        const status = document.getElementById('statusMessage');
        status.textContent = message;
        status.classList.remove('error', 'success', 'info');

        if (isError) {
          status.classList.add('error');
        } else {
          status.classList.add(type);
        }

        status.classList.add('show');

        // Announce to screen readers
        const saveStatus = document.getElementById('saveStatus');
        if (saveStatus) {
          saveStatus.textContent = message;
          // Clear after announcement
          setTimeout(() => {
            saveStatus.textContent = '';
          }, 3000);
        }

        setTimeout(() => {
          status.classList.remove('show');
        }, 2000);
      }

      // Initialize on page load
      window.addEventListener('DOMContentLoaded', init);
