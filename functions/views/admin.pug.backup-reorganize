      async function importSelectedFreesounds() {
        const category = document.getElementById('freesoundCategory').value;
        const checkboxes = document.querySelectorAll('.freesound-checkbox:checked');

        if (checkboxes.length === 0) {
          showStatus('Please select at least one sound to import', true);
          return;
        }

        const selectedSounds = [];
        checkboxes.forEach(cb => {
          const index = parseInt(cb.getAttribute('data-index'));
          selectedSounds.push(freesoundResults[index]);
        });

        showStatus('⬇️ Importing ' + selectedSounds.length + ' sounds...');

        let succeeded = 0;
        let failed = 0;

        for (const sound of selectedSounds) {
          try {
            const filename = sound.name.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '') + '.mp3';

            const response = await fetch('/api/freesound/download', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({
                soundId: sound.id,
                category: category,
                filename: filename,
                apiKey: freesoundApiKey
              })
            });

            if (response.ok) {
              succeeded++;
            } else {
              failed++;
            }

          } catch (error) {
            console.error('Import error for ' + sound.name + ':', error);
            failed++;
          }
        }

        showStatus('✅ Import complete: ' + succeeded + ' succeeded, ' + failed + ' failed');

        if (succeeded > 0) {
          setTimeout(() => window.location.reload(), 2000);
        }
      }

