        let html = '<div style="display: flex; flex-direction: column; gap: var(--space-2);">';
        keys.forEach(key => {
          const template = instructionTemplates[key];
          html += '<label style="display: flex; align-items: start; gap: var(--space-2); padding: var(--space-2); background: white; border-radius: var(--radius-sm); cursor: pointer; border: 1px solid #E5E5E5;">';
