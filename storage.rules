rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Allow anyone to read sound files
    // Allow anyone to write (upload/delete) sound files
    // Note: In production, you may want to add authentication
    match /sounds/{category}/{filename} {
      allow read: if true;
      allow write: if true;
      allow delete: if true;
    }
  }
}
