    script(src="https://www.gstatic.com/firebasejs/10.7.0/firebase-auth-compat.js")

    script.
      // Firebase configuration
      const firebaseConfig = {
        apiKey: "AIzaSyA1yMZIjtukkRNYAgki_hW68JcmQixkGaE",
        authDomain: "wonderful-life-sound.firebaseapp.com",
        projectId: "wonderful-life-sound"
      };

      // Initialize Firebase Auth
      firebase.initializeApp(firebaseConfig);
      const auth = firebase.auth();

      // Check authentication on page load
      auth.onAuthStateChanged(async (user) => {
        if (!user) {
          // No user signed in, redirect to login
          window.location.href = '/admin/login';
        } else {
          console.log('User authenticated:', user.email);
          // User is signed in, we're good
        }
      });

      // Logout function
      async function logout() {
        try {
          await auth.signOut();
          await fetch('/admin/logout', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' }
          });
          window.location.href = '/admin/login';
        } catch (error) {
          console.error('Logout error:', error);
          alert('Logout failed. Please try again.');
        }
      }

      // Tab switching
      function switchTab(tabName) {
        document.querySelectorAll('.tab-content').forEach(tab => {
          tab.classList.remove('active');
        });
        document.querySelectorAll('.tab').forEach(tab => {
          tab.classList.remove('active');
          tab.setAttribute('aria-selected', 'false');
        });

        document.getElementById(tabName + 'Tab').classList.add('active');
        event.target.classList.add('active');
        event.target.setAttribute('aria-selected', 'true');
      }

      // Toggle category visibility
      function toggleCategory(categoryKey) {
        const content = document.getElementById(`cat-${categoryKey}`);
        const header = event.currentTarget;
        if (content.style.display === 'none') {
          content.style.display = 'block';
          header.setAttribute('aria-expanded', 'true');
        } else {
          content.style.display = 'none';
          header.setAttribute('aria-expanded', 'false');
        }
      }

      // Upload sound file
      async function uploadSound() {
        const categoryKey = document.getElementById('uploadCategory').value;
        const fileInput = document.getElementById('uploadFile');
        const customFilename = document.getElementById('uploadFilename').value.trim();
        const file = fileInput.files[0];

        if (!categoryKey) {
          showStatus('Please select a category', true);
          return;
        }

        if (!file) {
          showStatus('Please select an MP3 file', true);
          return;
        }

        if (!file.type.includes('audio') && !file.name.endsWith('.mp3')) {
          showStatus('Please select an MP3 audio file', true);
          return;
        }

        document.getElementById('uploadProgress').style.display = 'block';
        document.getElementById('uploadProgressBar').style.width = '0%';
        document.getElementById('uploadProgressBar').textContent = '0%';
        document.getElementById('uploadStatus').textContent = 'Uploading...';

        try {
          const formData = new FormData();
          formData.append('category', categoryKey);
          formData.append('customFilename', customFilename);
          formData.append('file', file);

          document.getElementById('uploadProgressBar').style.width = '50%';
          document.getElementById('uploadProgressBar').textContent = '50%';

          const response = await fetch('/api/upload', {
            method: 'POST',
            body: formData
          });

          document.getElementById('uploadProgressBar').style.width = '100%';
          document.getElementById('uploadProgressBar').textContent = '100%';

          if (!response.ok) {
            const error = await response.json();
            throw new Error(error.error || 'Upload failed');
          }

          const result = await response.json();

          showStatus(`✅ Uploaded ${result.filename}`);

          fileInput.value = '';
          document.getElementById('uploadFilename').value = '';
          document.getElementById('uploadProgress').style.display = 'none';

          setTimeout(() => window.location.reload(), 1500);

        } catch (error) {
          console.error('Error uploading sound:', error);
          showStatus('Error uploading sound: ' + error.message, true);
          document.getElementById('uploadProgress').style.display = 'none';
        }
      }

      // Delete sound
      async function deleteSound(categoryKey, filename) {
        if (!confirm(`Delete "${filename}" from ${categoryKey}?\\n\\nThis will permanently delete the file and remove it from the database.`)) {
          return;
        }

        try {
          const response = await fetch('/api/delete', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json'
            },
            body: JSON.stringify({
              categoryKey,
              filename
            })
          });

          if (!response.ok) {
            const error = await response.json();
            throw new Error(error.error || 'Delete failed');
          }

          showStatus(`✅ Deleted ${filename}`);
          setTimeout(() => window.location.reload(), 1500);

        } catch (error) {
          console.error('Error deleting sound:', error);
          showStatus('Error deleting sound: ' + error.message, true);
        }
      }

      // Show status message
      function showStatus(message, isError = false) {
        const statusEl = document.getElementById('statusMessage');
        statusEl.textContent = message;
        if (isError) {
          statusEl.classList.add('error');
        } else {
          statusEl.classList.remove('error');
        }
        statusEl.classList.add('show');

        setTimeout(() => {
          statusEl.classList.remove('show');
        }, 3000);
      }

      // Unflag a sound
      async function unflagSound(fileId) {
        try {
          const response = await fetch('/api/selections/delete-flag', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ fileId, isFlagged: false })
          });

          if (!response.ok) {
            const error = await response.json();
            throw new Error(error.error || 'Unflag failed');
          }

          showStatus(`✅ File unflagged`);
          setTimeout(() => window.location.reload(), 1000);

        } catch (error) {
          console.error('Error unflagging sound:', error);
          showStatus('Error unflagging sound: ' + error.message, true);
        }
      }

      // Delete a flagged sound
      async function deleteFlaggedSound(categoryKey, filename, fileId) {
        if (!confirm(`Delete "${filename}"?\\n\\nThis will permanently delete the file.`)) {
          return;
        }

        try {
          const response = await fetch('/api/delete', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ categoryKey, filename })
          });

          if (!response.ok) {
            const error = await response.json();
            throw new Error(error.error || 'Delete failed');
          }

          await fetch('/api/selections/delete-flag', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ fileId, isFlagged: false })
          });

          showStatus(`✅ Deleted ${filename}`);
          setTimeout(() => window.location.reload(), 1000);

        } catch (error) {
          console.error('Error deleting sound:', error);
          showStatus('Error deleting sound: ' + error.message, true);
        }
      }

      // Delete all flagged sounds
      async function deleteAllFlagged() {
        const flaggedItems = document.querySelectorAll('#flaggedContent .sound-item');
        const count = flaggedItems.length;

        if (!confirm(`Delete ALL ${count} flagged files?\\n\\nThis action cannot be undone!`)) {
          return;
        }

        showStatus(`Deleting ${count} files...`);
        let deleted = 0;
        let errors = 0;

        for (const item of flaggedItems) {
          const deleteBtn = item.querySelector('.btn-danger');
          const onclickAttr = deleteBtn.getAttribute('onclick');
          const matches = onclickAttr.match(/deleteFlaggedSound\('([^']+)', '([^']+)', '([^']+)'\)/);

          if (matches) {
            const [, categoryKey, filename] = matches;

            try {
              const response = await fetch('/api/delete', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ categoryKey, filename })
              });

              if (response.ok) {
                deleted++;
                item.style.opacity = '0.3';
              } else {
                errors++;
              }
            } catch (error) {
              console.error(`Error deleting ${filename}:`, error);
              errors++;
            }
          }
        }

        if (errors > 0) {
          showStatus(`⚠️ Deleted ${deleted} files, ${errors} errors`, true);
        } else {
          showStatus(`✅ Deleted all ${deleted} files`);
        }

        setTimeout(() => window.location.reload(), 2000);
      }

      // Load saved instruction templates on page load
      let instructionTemplates = {};

      async function loadInstructionTemplates() {
        try {
          const response = await fetch('/api/instruction-templates');
          const data = await response.json();
          instructionTemplates = data || {};
          displayInstructionTemplates();
        } catch (error) {
          console.error('Error loading instruction templates:', error);
          document.getElementById('savedInstructionsContainer').innerHTML = '<p style="color: var(--color-text-muted); font-style: italic; font-size: 0.875rem;">No saved templates yet.</p>';
        }
      }

      function displayInstructionTemplates() {
        const container = document.getElementById('savedInstructionsContainer');
        const keys = Object.keys(instructionTemplates);

        if (keys.length === 0) {
          container.innerHTML = '<p style="color: var(--color-text-muted); font-style: italic; font-size: 0.875rem;">No saved templates yet. Click "➕ Manage Templates" to create one.</p>';
          return;
        }

        let html = '<div style="display: flex; flex-direction: column; gap: var(--space-2);">';
        keys.forEach(key => {
          const template = instructionTemplates[key];
          html += '<label style="display: flex; align-items: start; gap: var(--space-2); padding: var(--space-2); background: white; border-radius: var(--radius-sm); cursor: pointer; border: 1px solid #E5E5E5;">';
          html += '<input type="checkbox" class="instruction-checkbox" data-key="' + key + '" style="margin-top: 4px; min-width: 18px; min-height: 18px;">';
          html += '<div style="flex: 1;">';
          html += '<strong style="color: var(--color-text);">' + template.name + '</strong>';
          html += '<p style="margin: 4px 0 0 0; font-size: 0.875rem; color: var(--color-text-muted);">' + template.content + '</p>';
          html += '</div>';
          html += '<button onclick="deleteInstructionTemplate(\'' + key + '\'); return false;" class="btn btn-danger" style="padding: 4px 8px; min-height: 28px; font-size: 0.75rem;" type="button">🗑️</button>';
          html += '</label>';
        });
        html += '</div>';
        container.innerHTML = html;
      }

      function toggleInstructionManager() {
        const manager = document.getElementById('instructionManager');
        if (manager.style.display === 'none') {
          manager.style.display = 'block';
        } else {
          manager.style.display = 'none';
          document.getElementById('newInstructionName').value = '';
          document.getElementById('newInstructionContent').value = '';
        }
      }

      async function saveInstructionTemplate() {
        const name = document.getElementById('newInstructionName').value.trim();
        const content = document.getElementById('newInstructionContent').value.trim();

        if (!name || !content) {
          showStatus('Please enter both template name and instruction text', true);
          return;
        }

        try {
          const response = await fetch('/api/instruction-templates', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ name, content })
          });

          if (!response.ok) {
            throw new Error('Failed to save template');
          }

          showStatus('✅ Template saved successfully!');
          document.getElementById('newInstructionName').value = '';
          document.getElementById('newInstructionContent').value = '';
          toggleInstructionManager();
          await loadInstructionTemplates();

        } catch (error) {
          console.error('Error saving template:', error);
          showStatus('Error saving template: ' + error.message, true);
        }
      }

      async function deleteInstructionTemplate(key) {
        if (!confirm('Delete this instruction template?')) {
          return;
        }

        try {
          const response = await fetch('/api/instruction-templates/' + key, {
            method: 'DELETE'
          });

          if (!response.ok) {
            throw new Error('Failed to delete template');
          }

          showStatus('✅ Template deleted');
          await loadInstructionTemplates();

        } catch (error) {
          console.error('Error deleting template:', error);
          showStatus('Error deleting template: ' + error.message, true);
        }
      }

      // API Keys Integration
      let freesoundApiKey = localStorage.getItem('freesoundApiKey') || '';
      let pixabayApiKey = localStorage.getItem('pixabayApiKey') || '';
      let freesoundResults = [];

      function saveFreesoundApiKey() {
        const apiKey = document.getElementById('freesoundApiKey').value.trim();
        if (!apiKey) {
          showStatus('Please enter an API key', true);
          return;
        }
        localStorage.setItem('freesoundApiKey', apiKey);
        freesoundApiKey = apiKey;
        document.getElementById('freesoundSearchSection').style.display = 'block';
        showStatus('✅ Freesound API key saved!');
      }

      function savePixabayApiKey() {
        const apiKey = document.getElementById('pixabayApiKey').value.trim();
        if (!apiKey) {
          showStatus('Please enter an API key', true);
          return;
        }
        localStorage.setItem('pixabayApiKey', apiKey);
        pixabayApiKey = apiKey;
        showStatus('✅ Pixabay API key saved!');
      }

      async function searchFreesound() {
        const query = document.getElementById('freesoundQuery').value.trim();
        const category = document.getElementById('freesoundCategory').value;

        if (!query) {
          showStatus('Please enter a search query', true);
          return;
        }

        if (!category) {
          showStatus('Please select a category', true);
          return;
        }

        if (!freesoundApiKey) {
          showStatus('Please enter and save your Freesound API key first', true);
          return;
        }

        try {
          showStatus('🔍 Searching Freesound.org...');

          let filterStr = '';
          if (document.getElementById('freesoundFilter').checked) {
            filterStr += '&filter=duration:[0 TO 10]';
          }
          if (document.getElementById('freesoundLicense').checked) {
            filterStr += '&filter=license:"Creative Commons 0"';
          }

          const response = await fetch('/api/freesound/search?query=' + encodeURIComponent(query) + filterStr + '&apiKey=' + encodeURIComponent(freesoundApiKey));

          if (!response.ok) {
            const error = await response.json();
            throw new Error(error.error || 'Search failed');
          }

          const data = await response.json();
          freesoundResults = data.results || [];

          displayFreesoundResults(category);
          showStatus('✅ Found ' + freesoundResults.length + ' sounds');

        } catch (error) {
          console.error('Freesound search error:', error);
          showStatus('Error searching Freesound: ' + error.message, true);
        }
