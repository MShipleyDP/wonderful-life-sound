      // Generate custom AI prompt based on category and description
      function generatePrompt() {
        const categoryType = document.querySelector('input[name="categoryType"]:checked').value;
        const description = document.getElementById('promptDescription').value.trim();
        const directorNotes = document.getElementById('directorNotes').value.trim();

        // Get selected instruction templates
        const selectedInstructions = [];
        document.querySelectorAll('.instruction-checkbox:checked').forEach(checkbox => {
          const key = checkbox.getAttribute('data-key');
          if (instructionTemplates[key]) {
            selectedInstructions.push(instructionTemplates[key].content);
          }
        });

        let categoryKey, categoryTitle;

        // Get category info based on type
        if (categoryType === 'existing') {
          categoryKey = document.getElementById('promptCategory').value;
          if (!categoryKey) {
            showStatus('Please select a category', true);
            return;
          }
          const categorySelect = document.getElementById('promptCategory');
          categoryTitle = categorySelect.options[categorySelect.selectedIndex].text;
        } else {
          // New category
          categoryKey = document.getElementById('newCategoryKey').value.trim();
          categoryTitle = document.getElementById('newCategoryTitle').value.trim();

          if (!categoryKey || !categoryTitle) {
            showStatus('Please enter both category key and display name', true);
            return;
          }

          // Validate category key format
          if (!/^[a-z0-9-]+$/.test(categoryKey)) {
            showStatus('Category key must be lowercase letters, numbers, and hyphens only', true);
            return;
          }
        }

        if (!description) {
          showStatus('Please describe the sounds you need', true);
          return;
        }

        // Build the prompt
        let promptTemplate = "I need you to search for royalty-free sound effects and return them in JSON format.\n\n" +
          "RESEARCH REQUIREMENTS:\n" +
          "- Do DEEP and THOROUGH research across multiple sound libraries\n" +
          "- Look extensively through Freesound.org and Pixabay.com\n" +
          "- Don't just return the first few results - dig deep for the BEST quality sounds\n" +
          "- Compare multiple options and return only the highest quality matches\n" +
          "- Take your time to find authentic, professional-grade sound effects\n\n" +
          "I am looking for sounds for the category: \"" + categoryTitle + "\"\n\n" +
          "Please find sound effects based on this description:\n" + description + "\n\n";

        // Add director notes if provided
        if (directorNotes) {
          promptTemplate += "DIRECTOR'S SPECIFIC REQUIREMENTS:\n" + directorNotes + "\n\n";
        }

        // Add selected custom instruction templates
        if (selectedInstructions.length > 0) {
          promptTemplate += "ADDITIONAL INSTRUCTIONS:\n";
          selectedInstructions.forEach((instruction, index) => {
            promptTemplate += (index + 1) + ". " + instruction + "\n";
          });
          promptTemplate += "\n";
        }

        // Add note about API keys being configured
        promptTemplate += "IMPORTANT - API KEYS:\n" +
          "My system already has Freesound and Pixabay API keys configured. You do NOT need to include freesoundApiKey or pixabayApiKey fields in your JSON response. Just provide the URLs.\n\n";

        // Build the JSON format based on category type
        let jsonFormat = "{\n  \"sounds\": [\n    {\n" +
          "      \"url\": \"https://direct-link-to-mp3-file.mp3\",\n" +
          "      \"category\": \"" + categoryKey + "\",\n" +
          "      \"filename\": \"descriptive-name.mp3\",\n" +
          "      \"description\": \"Brief description of the sound\"";

        if (categoryType === 'new') {
          jsonFormat += ",\n      \"categoryTitle\": \"" + categoryTitle + "\"";
        }

        jsonFormat += "\n    }\n  ]\n}";

        promptTemplate += "Return results in this EXACT JSON format:\n" + jsonFormat + "\n\n" +
          "IMPORTANT Requirements:\n" +
          "- URLs must be DIRECT links to .mp3 files (not download pages or zip files)\n" +
          "- Use lowercase, hyphenated filenames (e.g., \"church-bell-ringing.mp3\")\n" +
          "- The \"category\" field MUST be exactly: \"" + categoryKey + "\"\n";

        if (categoryType === 'new') {
          promptTemplate += "- The \"categoryTitle\" field MUST be exactly: \"" + categoryTitle + "\" (this creates the new category)\n";
        }

        promptTemplate += "- Only include sounds from royalty-free sources (freesound.org, pixabay, soundbible, etc.)\n" +
          "- You can provide Freesound URLs (https://freesound.org/people/user/sounds/12345/) or Pixabay URLs (https://pixabay.com/sound-effects/name-12345/) - my system will handle authentication automatically\n" +
          "- Ensure all URLs are working direct download links or valid Freesound/Pixabay URLs\n";

        if (directorNotes) {
          promptTemplate += "- Pay close attention to the director's requirements above\n";
        }

        promptTemplate += "- Do NOT include freesoundApiKey or pixabayApiKey in your response - they are already configured\n" +
          "- Return ONLY the JSON object, no other text or markdown formatting\n\n" +
          "Example of valid entries:\n" +
          "{\n" +
          "  \"sounds\": [\n" +
          "    {\n" +
          "      \"url\": \"https://freesound.org/people/InspectorJ/sounds/411789/\",\n" +
          "      \"category\": \"" + categoryKey + "\",\n" +
          "      \"filename\": \"church-bell-freesound.mp3\",\n" +
          "      \"description\": \"Large church bell from Freesound\"";

        if (categoryType === 'new') {
          promptTemplate += ",\n      \"categoryTitle\": \"" + categoryTitle + "\"";
        }

        promptTemplate += "\n    },\n" +
          "    {\n" +
          "      \"url\": \"https://pixabay.com/sound-effects/church-bell-12345/\",\n" +
          "      \"category\": \"" + categoryKey + "\",\n" +
          "      \"filename\": \"church-bell-pixabay.mp3\",\n" +
          "      \"description\": \"Church bell from Pixabay\"";

        if (categoryType === 'new') {
          promptTemplate += ",\n      \"categoryTitle\": \"" + categoryTitle + "\"";
        }

        promptTemplate += "\n    }\n" +
          "  ]\n" +
          "}";

        // Show the generated prompt
        document.getElementById('aiPrompt').value = promptTemplate;
        document.getElementById('promptGenerator').style.display = 'block';

        // Scroll to the generated prompt
        document.getElementById('promptGenerator').scrollIntoView({ behavior: 'smooth', block: 'nearest' });

        showStatus('✅ Prompt generated! Copy and paste into your AI assistant');
      }

      // Copy AI prompt to clipboard
      function copyPrompt() {
        const promptText = document.getElementById('aiPrompt');
        promptText.select();
        document.execCommand('copy');
        showStatus('✅ Prompt copied to clipboard!');
      }

      // Batch import from JSON
      async function batchImport() {
        const jsonInput = document.getElementById('importJson').value.trim();

        if (!jsonInput) {
          showStatus('Please paste JSON data', true);
          return;
        }

        let data;
        try {
          data = JSON.parse(jsonInput);
        } catch (error) {
          showStatus('Invalid JSON format: ' + error.message, true);
          return;
        }

        if (!data.sounds || !Array.isArray(data.sounds)) {
          showStatus('JSON must contain a "sounds" array', true);
          return;
        }

        if (data.sounds.length === 0) {
          showStatus('No sounds to import', true);
          return;
        }

        // Validate each sound
        for (let i = 0; i < data.sounds.length; i++) {
          const sound = data.sounds[i];
          if (!sound.url || !sound.category || !sound.filename) {
            showStatus(`Sound ${i + 1} missing required fields (url, category, filename)`, true);
            return;
          }
        }

        // Show progress
        const progressContainer = document.getElementById('importProgress');
        const progressBar = document.getElementById('importProgressBar');
        const progressText = document.getElementById('importProgressText');
        const statusDiv = document.getElementById('importStatus');

        progressContainer.style.display = 'block';
        progressBar.style.width = '0%';
        progressText.textContent = '0%';
        statusDiv.innerHTML = '<p>Starting batch import...</p>';

        const total = data.sounds.length;
        let completed = 0;
        let succeeded = 0;
        let failed = 0;
        const results = [];

        // Get API keys from JSON if provided, otherwise use saved keys from localStorage
        const jsonFreesoundKey = data.freesoundApiKey || '';
        const jsonPixabayKey = data.pixabayApiKey || '';

        const effectiveFreesoundKey = jsonFreesoundKey || localStorage.getItem('freesoundApiKey') || '';
        const effectivePixabayKey = jsonPixabayKey || localStorage.getItem('pixabayApiKey') || '';

        for (const sound of data.sounds) {
          try {
            statusDiv.innerHTML = `<p>Processing: ${sound.filename} (${completed + 1}/${total})</p>`;

            const response = await fetch('/api/batch-import', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({
                url: sound.url,
                category: sound.category,
                filename: sound.filename,
                description: sound.description || '',
                categoryTitle: sound.categoryTitle || '',
                freesoundApiKey: effectiveFreesoundKey,
                pixabayApiKey: effectivePixabayKey
              })
            });

            const result = await response.json();

            if (response.ok) {
              succeeded++;
              results.push(`✅ ${sound.filename}: Success`);
            } else {
              failed++;
              results.push(`❌ ${sound.filename}: ${result.error || 'Failed'}`);
            }
          } catch (error) {
            failed++;
            results.push(`❌ ${sound.filename}: ${error.message}`);
          }

          completed++;
          const percent = Math.round((completed / total) * 100);
          progressBar.style.width = percent + '%';
          progressText.textContent = percent + '%';
        }

        // Show final results
        statusDiv.innerHTML = `
          <h4>Import Complete</h4>
          <p><strong>✅ Succeeded:</strong> ${succeeded}</p>
          <p><strong>❌ Failed:</strong> ${failed}</p>
          <div style="max-height: 200px; overflow-y: auto; margin-top: var(--space-2); padding: var(--space-2); background: #f5f5f5; border-radius: var(--radius-sm); font-size: 0.875rem;">
            ${results.map(r => `<p style="margin: 4px 0;">${r}</p>`).join('')}
          </div>
        `;

        showStatus(`Import complete: ${succeeded} succeeded, ${failed} failed`);

        if (succeeded > 0) {
          setTimeout(() => window.location.reload(), 3000);
        }
      }

      // Preview import - parse JSON and display sounds for selection
      function previewImport() {
        const jsonInput = document.getElementById('importJson').value.trim();

        if (!jsonInput) {
          showStatus('Please paste JSON data', true);
          return;
        }

        let data;
        try {
          data = JSON.parse(jsonInput);
        } catch (error) {
          showStatus('Invalid JSON format: ' + error.message, true);
          return;
        }

        if (!data.sounds || !Array.isArray(data.sounds)) {
          showStatus('JSON must contain a "sounds" array', true);
          return;
        }

        if (data.sounds.length === 0) {
          showStatus('No sounds to import', true);
          return;
        }

        // Validate each sound
        for (let i = 0; i < data.sounds.length; i++) {
          const sound = data.sounds[i];
          if (!sound.url || !sound.category || !sound.filename) {
            showStatus('Sound ' + (i + 1) + ' missing required fields (url, category, filename)', true);
            return;
          }
        }

        // Build preview cards
        const previewList = document.getElementById('previewSoundsList');
        previewList.innerHTML = '';

        data.sounds.forEach((sound, index) => {
          const card = document.createElement('div');
          card.className = 'preview-sound-card';
          card.setAttribute('data-index', index);

          // Check if URL is a direct MP3, Freesound, or Pixabay
          const isDirectMp3 = sound.url.endsWith('.mp3') && !sound.url.includes('freesound.org') && !sound.url.includes('pixabay.com');
          const isFreesound = sound.url.includes('freesound.org');
          const isPixabay = sound.url.includes('pixabay.com');

          let audioPreview = '';
          if (isDirectMp3) {
            audioPreview = '<audio controls preload="none" style="width: 100%; margin-top: var(--space-2);"><source src="' + sound.url + '" type="audio/mpeg">Your browser does not support audio playback.</audio>';
          } else if (isFreesound) {
            audioPreview = '<p style="color: var(--color-info); font-size: 0.875rem; margin-top: var(--space-2);">🎵 Freesound.org - Preview available after import</p>';
          } else if (isPixabay) {
            audioPreview = '<p style="color: var(--color-info); font-size: 0.875rem; margin-top: var(--space-2);">🎵 Pixabay - Preview available after import</p>';
          } else {
            audioPreview = '<p style="color: var(--color-text-muted); font-size: 0.875rem; margin-top: var(--space-2);">⚠️ Preview not available for this URL type</p>';
          }

          card.innerHTML =
            '<div style="display: flex; align-items: flex-start; gap: var(--space-3); padding: var(--space-3); background: white; border: 2px solid #E5E5E5; border-radius: var(--radius-sm); margin-bottom: var(--space-2);">' +
              '<input type="checkbox" class="preview-checkbox" checked onchange="updatePreviewCounter()" style="width: 24px; height: 24px; margin-top: 4px; cursor: pointer;">' +
              '<div style="flex: 1;">' +
                '<h4 style="margin: 0 0 var(--space-1) 0; color: var(--color-primary); font-size: 1rem;">' + sound.filename + '</h4>' +
                '<p style="margin: 0 0 var(--space-1) 0; color: var(--color-text-muted); font-size: 0.875rem;"><strong>Category:</strong> ' + sound.category + (sound.categoryTitle ? ' (' + sound.categoryTitle + ')' : '') + '</p>' +
                (sound.description ? '<p style="margin: 0 0 var(--space-1) 0; color: var(--color-text); font-size: 0.875rem;">' + sound.description + '</p>' : '') +
                '<p style="margin: 0; color: var(--color-text-muted); font-size: 0.75rem; word-break: break-all;"><strong>URL:</strong> ' + sound.url + '</p>' +
                audioPreview +
              '</div>' +
            '</div>';

          previewList.appendChild(card);
        });

        // Show preview section
        document.getElementById('importPreview').style.display = 'block';
        document.getElementById('previewTotalCount').textContent = data.sounds.length;
        updatePreviewCounter();

        // Scroll to preview
        document.getElementById('importPreview').scrollIntoView({ behavior: 'smooth', block: 'nearest' });

        showStatus('✅ Preview loaded! Select sounds to import');
      }

      // Select all preview checkboxes
      function selectAllPreview() {
        const checkboxes = document.querySelectorAll('.preview-checkbox');
        checkboxes.forEach(cb => cb.checked = true);
        updatePreviewCounter();
      }

      // Deselect all preview checkboxes
      function deselectAllPreview() {
        const checkboxes = document.querySelectorAll('.preview-checkbox');
        checkboxes.forEach(cb => cb.checked = false);
        updatePreviewCounter();
      }

      // Update preview counter
      function updatePreviewCounter() {
        const checkboxes = document.querySelectorAll('.preview-checkbox');
        const checkedCount = Array.from(checkboxes).filter(cb => cb.checked).length;
        document.getElementById('previewSelectedCount').textContent = checkedCount;
      }

      // Import only selected sounds
      async function importSelectedSounds() {
        const jsonInput = document.getElementById('importJson').value.trim();

        if (!jsonInput) {
          showStatus('Please paste JSON data', true);
          return;
        }

        let data;
        try {
          data = JSON.parse(jsonInput);
        } catch (error) {
          showStatus('Invalid JSON format: ' + error.message, true);
          return;
        }

        // Get selected sounds based on checkboxes
        const checkboxes = document.querySelectorAll('.preview-checkbox');
        const selectedSounds = [];

        checkboxes.forEach((checkbox, index) => {
          if (checkbox.checked) {
            selectedSounds.push(data.sounds[index]);
          }
        });

        if (selectedSounds.length === 0) {
          showStatus('Please select at least one sound to import', true);
          return;
        }

        // Hide preview, show progress
        document.getElementById('importPreview').style.display = 'none';

        const progressContainer = document.getElementById('importProgress');
        const progressBar = document.getElementById('importProgressBar');
        const progressText = document.getElementById('importProgressText');
        const statusDiv = document.getElementById('importStatus');

        progressContainer.style.display = 'block';
        progressBar.style.width = '0%';
        progressText.textContent = '0%';
        statusDiv.innerHTML = '<p>Starting import of ' + selectedSounds.length + ' selected sounds...</p>';

        const total = selectedSounds.length;
        let completed = 0;
        let succeeded = 0;
        let failed = 0;
        const results = [];

        // Get API keys from JSON if provided, otherwise use saved keys from localStorage
        const jsonFreesoundKey = data.freesoundApiKey || '';
        const jsonPixabayKey = data.pixabayApiKey || '';

        const effectiveFreesoundKey = jsonFreesoundKey || localStorage.getItem('freesoundApiKey') || '';
        const effectivePixabayKey = jsonPixabayKey || localStorage.getItem('pixabayApiKey') || '';

        for (const sound of selectedSounds) {
          try {
            statusDiv.innerHTML = '<p>Processing: ' + sound.filename + ' (' + (completed + 1) + '/' + total + ')</p>';

            const response = await fetch('/api/batch-import', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({
                url: sound.url,
                category: sound.category,
                filename: sound.filename,
                description: sound.description || '',
                categoryTitle: sound.categoryTitle || '',
                freesoundApiKey: effectiveFreesoundKey,
                pixabayApiKey: effectivePixabayKey
              })
            });

            const result = await response.json();

            if (response.ok) {
              succeeded++;
              results.push('✅ ' + sound.filename + ': Success');
            } else {
              failed++;
              results.push('❌ ' + sound.filename + ': ' + (result.error || 'Failed'));
            }
          } catch (error) {
            failed++;
            results.push('❌ ' + sound.filename + ': ' + error.message);
          }

          completed++;
          const percent = Math.round((completed / total) * 100);
          progressBar.style.width = percent + '%';
          progressText.textContent = percent + '%';
        }

        // Show final results
        statusDiv.innerHTML =
          '<h4>Import Complete</h4>' +
          '<p><strong>✅ Succeeded:</strong> ' + succeeded + '</p>' +
          '<p><strong>❌ Failed:</strong> ' + failed + '</p>' +
          '<div style="max-height: 200px; overflow-y: auto; margin-top: var(--space-2); padding: var(--space-2); background: #f5f5f5; border-radius: var(--radius-sm); font-size: 0.875rem;">' +
            results.map(r => '<p style="margin: 4px 0;">' + r + '</p>').join('') +
          '</div>';

        showStatus('Import complete: ' + succeeded + ' succeeded, ' + failed + ' failed');

        if (succeeded > 0) {
          setTimeout(() => window.location.reload(), 3000);
        }
      }
