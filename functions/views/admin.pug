      // Switch Main Tabs (Tier 1)
      function switchMainTab(mainTabName) {
        // Hide all main tab content
        document.querySelectorAll('.main-tab-content').forEach(content => {
          content.classList.remove('active');
        });

        // Deactivate all main tabs
        document.querySelectorAll('.main-tab').forEach(tab => {
          tab.classList.remove('active');
          tab.setAttribute('aria-selected', 'false');
        });

        // Hide all sub-tab bars
        document.querySelectorAll('.sub-tabs').forEach(subtabs => {
          subtabs.classList.remove('active');
        });

        // Activate selected main tab
        document.getElementById(mainTabName + '-panel').classList.add('active');
        document.getElementById(mainTabName + '-tab').classList.add('active');
        document.getElementById(mainTabName + '-tab').setAttribute('aria-selected', 'true');

        // Show corresponding sub-tabs
        document.getElementById(mainTabName + '-subtabs').classList.add('active');

        // Activate first sub-tab by default
        const firstSubTab = document.querySelector(`#${mainTabName}-subtabs .sub-tab`);
        if (firstSubTab) {
          firstSubTab.click();
        }
      }

      // Switch Sub-Tabs (Tier 2)
      function switchSubTab(mainTabName, subTabName) {
        // Get parent main tab's content area
        const mainTabContent = document.getElementById(mainTabName + '-panel');

        // Hide all sub-tab content within this main tab
        mainTabContent.querySelectorAll('.sub-tab-content').forEach(content => {
          content.classList.remove('active');
        });

        // Deactivate all sub-tabs within this group
        document.querySelectorAll(`#${mainTabName}-subtabs .sub-tab`).forEach(tab => {
          tab.classList.remove('active');
        });

        // Activate selected sub-tab content
        document.getElementById(mainTabName + '-' + subTabName).classList.add('active');

        // Activate selected sub-tab button
        event.target.classList.add('active');
      }

      // Toggle category visibility
      function toggleCategory(categoryKey) {
        const content = document.getElementById(`cat-${categoryKey}`);
        const header = event.currentTarget;
        if (content.style.display === 'none') {
          content.style.display = 'block';
          header.setAttribute('aria-expanded', 'true');
        } else {
          content.style.display = 'none';
          header.setAttribute('aria-expanded', 'false');
        }
      }

      // Upload sound file
      async function uploadSound() {
        const categoryKey = document.getElementById('uploadCategory').value;
        const fileInput = document.getElementById('uploadFile');
        const customFilename = document.getElementById('uploadFilename').value.trim();
        const file = fileInput.files[0];

        if (!categoryKey) {
          showStatus('Please select a category', true);
          return;
        }

        if (!file) {
          showStatus('Please select an MP3 file', true);
          return;
        }

        if (!file.type.includes('audio') && !file.name.endsWith('.mp3')) {
          showStatus('Please select an MP3 audio file', true);
          return;
        }

        document.getElementById('uploadProgress').style.display = 'block';
        document.getElementById('uploadProgressBar').style.width = '0%';
        document.getElementById('uploadProgressBar').textContent = '0%';
        document.getElementById('uploadStatus').textContent = 'Uploading...';

        try {
          const formData = new FormData();
          formData.append('category', categoryKey);
          formData.append('customFilename', customFilename);
          formData.append('file', file);

          document.getElementById('uploadProgressBar').style.width = '50%';
          document.getElementById('uploadProgressBar').textContent = '50%';

          const response = await fetch('/api/upload', {
            method: 'POST',
            body: formData
          });

          document.getElementById('uploadProgressBar').style.width = '100%';
          document.getElementById('uploadProgressBar').textContent = '100%';

          if (!response.ok) {
            const error = await response.json();
            throw new Error(error.error || 'Upload failed');
          }

          const result = await response.json();

          showStatus(`✅ Uploaded ${result.filename}`);

          fileInput.value = '';
          document.getElementById('uploadFilename').value = '';
          document.getElementById('uploadProgress').style.display = 'none';

          setTimeout(() => window.location.reload(), 1500);

        } catch (error) {
          console.error('Error uploading sound:', error);
          showStatus('Error uploading sound: ' + error.message, true);
          document.getElementById('uploadProgress').style.display = 'none';
        }
      }

      // Delete sound
      async function deleteSound(categoryKey, filename) {
        if (!confirm(`Delete "${filename}" from ${categoryKey}?\\n\\nThis will permanently delete the file and remove it from the database.`)) {
          return;
        }

        try {
          const response = await fetch('/api/delete', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json'
            },
            body: JSON.stringify({
              categoryKey,
              filename
            })
          });

          if (!response.ok) {
            const error = await response.json();
            throw new Error(error.error || 'Delete failed');
          }

          showStatus(`✅ Deleted ${filename}`);
          setTimeout(() => window.location.reload(), 1500);

        } catch (error) {
          console.error('Error deleting sound:', error);
          showStatus('Error deleting sound: ' + error.message, true);
        }
      }

