      async function saveInstructionTemplate() {
        const name = document.getElementById('newInstructionName').value.trim();
        const content = document.getElementById('newInstructionContent').value.trim();

        if (!name || !content) {
          showStatus('Please enter both template name and instruction text', true);
          return;
