      // Batch import from JSON
      async function batchImport() {
        const jsonInput = document.getElementById('importJson').value.trim();

        if (!jsonInput) {
          showStatus('Please paste JSON data', true);
          return;
        }

        let data;
        try {
          data = JSON.parse(jsonInput);
        } catch (error) {
          showStatus('Invalid JSON format: ' + error.message, true);
          return;
        }

        if (!data.sounds || !Array.isArray(data.sounds)) {
          showStatus('JSON must contain a "sounds" array', true);
          return;
        }

        if (data.sounds.length === 0) {
          showStatus('No sounds to import', true);
          return;
        }

        // Validate each sound
        for (let i = 0; i < data.sounds.length; i++) {
          const sound = data.sounds[i];
          if (!sound.url || !sound.category || !sound.filename) {
            showStatus(`Sound ${i + 1} missing required fields (url, category, filename)`, true);
            return;
          }
        }

        // Show progress
        const progressContainer = document.getElementById('importProgress');
        const progressBar = document.getElementById('importProgressBar');
        const progressText = document.getElementById('importProgressText');
        const statusDiv = document.getElementById('importStatus');

        progressContainer.style.display = 'block';
        progressBar.style.width = '0%';
        progressText.textContent = '0%';
        statusDiv.innerHTML = '<p>Starting batch import...</p>';

        const total = data.sounds.length;
        let completed = 0;
        let succeeded = 0;
        let failed = 0;
        const results = [];

        // Get API keys from JSON if provided, otherwise use saved keys from localStorage
        const jsonFreesoundKey = data.freesoundApiKey || '';
        const jsonPixabayKey = data.pixabayApiKey || '';

        const effectiveFreesoundKey = jsonFreesoundKey || localStorage.getItem('freesoundApiKey') || '';
        const effectivePixabayKey = jsonPixabayKey || localStorage.getItem('pixabayApiKey') || '';

        for (const sound of data.sounds) {
          try {
            statusDiv.innerHTML = `<p>Processing: ${sound.filename} (${completed + 1}/${total})</p>`;

            const response = await fetch('/api/batch-import', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({
                url: sound.url,
                category: sound.category,
                filename: sound.filename,
                description: sound.description || '',
                categoryTitle: sound.categoryTitle || '',
                freesoundApiKey: effectiveFreesoundKey,
                pixabayApiKey: effectivePixabayKey
              })
            });

            const result = await response.json();

            if (response.ok) {
              succeeded++;
              results.push(`✅ ${sound.filename}: Success`);
            } else {
              failed++;
              results.push(`❌ ${sound.filename}: ${result.error || 'Failed'}`);
            }
          } catch (error) {
            failed++;
            results.push(`❌ ${sound.filename}: ${error.message}`);
          }

          completed++;
          const percent = Math.round((completed / total) * 100);
          progressBar.style.width = percent + '%';
          progressText.textContent = percent + '%';
        }

        // Show final results
        statusDiv.innerHTML = `
          <h4>Import Complete</h4>
          <p><strong>✅ Succeeded:</strong> ${succeeded}</p>
          <p><strong>❌ Failed:</strong> ${failed}</p>
          <div style="max-height: 200px; overflow-y: auto; margin-top: var(--space-2); padding: var(--space-2); background: #f5f5f5; border-radius: var(--radius-sm); font-size: 0.875rem;">
            ${results.map(r => `<p style="margin: 4px 0;">${r}</p>`).join('')}
          </div>
        `;

        showStatus(`Import complete: ${succeeded} succeeded, ${failed} failed`);

        if (succeeded > 0) {
          setTimeout(() => window.location.reload(), 3000);
        }
      }

