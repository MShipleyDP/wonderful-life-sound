      // Delete all flagged sounds
      async function deleteAllFlagged() {
        // Get current delete flags from Firebase
        const flagsSnapshot = await db.ref('selections/deleteFlags').once('value');
        const deleteFlags = flagsSnapshot.val() || {};
        const flaggedFileIds = Object.keys(deleteFlags);
        const count = flaggedFileIds.length;

        if (count === 0) {
          showStatus('No files flagged for deletion', true);
          return;
        }

        if (!confirm(`Delete ALL ${count} flagged files?\\n\\nThis action cannot be undone!`)) {
          return;
        }

        showStatus(`Deleting ${count} files...`);
        let deleted = 0;
        let errors = 0;

        // Get sound data to map fileIds to actual files
        const soundsResponse = await fetch('/admin/data');
        const soundsData = await soundsResponse.json();
        const soundData = soundsData.soundData || {};

        for (const fileId of flaggedFileIds) {
          // Find the category and filename for this fileId
          let categoryKey = null;
          let filename = null;

          for (const catKey of Object.keys(soundData)) {
            if (fileId.startsWith(catKey + '_')) {
              categoryKey = catKey;
              const filenameWithoutExt = fileId.substring(catKey.length + 1);
              const category = soundData[catKey];

              if (category.files) {
                const file = category.files.find(f => {
                  const fname = f.filename || f;
                  const fnameWithoutExt = fname.replace(/\.[^/.]+$/, '');
                  return fnameWithoutExt === filenameWithoutExt;
                });

                if (file) {
                  filename = file.filename || file;
                  break;
                }
              }
            }
          }

          if (categoryKey && filename) {
            try {
              const response = await fetch('/api/delete', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ categoryKey, filename })
              });

              if (response.ok) {
                deleted++;
              } else {
                errors++;
              }
            } catch (error) {
              console.error(`Error deleting ${filename}:`, error);
              errors++;
            }
          } else {
            console.log('Could not find file for ID:', fileId);
            errors++;
          }
        }

        if (errors > 0) {
          showStatus(`⚠️ Deleted ${deleted} files, ${errors} errors`, true);
        } else {
          showStatus(`✅ Deleted all ${deleted} files`);
        }

        // The Firebase listener will automatically update the UI
      }

      // Clean up orphaned delete flags
      async function cleanupOrphanedFlags() {
        if (!confirm('Clean up orphaned delete flags?\n\nThis will remove flags for files that no longer exist.')) {
          return;
        }

        try {
          showStatus('🧹 Cleaning up orphaned flags...');

          const response = await fetch('/api/cleanup-flags', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' }
          });

          const data = await response.json();

          if (data.success) {
            console.log('Cleanup complete, removed:', data.orphanedFlags);
            showStatus(`✅ Cleaned up ${data.cleaned} orphaned flags`);

            // Fetch updated delete flags and rebuild UI
            const flagsSnapshot = await db.ref('selections/deleteFlags').once('value');
            const updatedFlags = flagsSnapshot.val() || {};
            await rebuildFlaggedItems(updatedFlags);
          } else {
            showStatus('Error cleaning up flags', true);
          }
        } catch (error) {
          showStatus('Error cleaning up flags: ' + error.message, true);
        }
      }

