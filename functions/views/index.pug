        fetch('/api/selections/delete-flag', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ category, filename, fileId, isFlagged })
        })
        .then(response => response.json())
        .then(data => {
          console.log('Delete flag saved:', fileId, isFlagged);
          pendingSaves.deleteFlags.delete(fileId);
          if (soundFile) {
            soundFile.classList.remove('saving');
            soundFile.classList.add('saved');
            setTimeout(() => soundFile.classList.remove('saved'), 1000);
          }
        })
        .catch(error => {
          console.error('Error saving delete flag:', error);
          if (soundFile) {
            soundFile.classList.remove('saving');
            soundFile.classList.add('error');
            setTimeout(() => soundFile.classList.remove('error'), 1000);
