    script(src="https://www.gstatic.com/firebasejs/10.7.0/firebase-app-compat.js")
    script(src="https://www.gstatic.com/firebasejs/10.7.0/firebase-auth-compat.js")
    script(src="https://www.gstatic.com/firebasejs/10.7.0/firebase-database-compat.js")

    script.
      // Firebase configuration
      const firebaseConfig = {
        apiKey: "AIzaSyA1yMZIjtukkRNYAgki_hW68JcmQixkGaE",
        authDomain: "wonderful-life-sound.firebaseapp.com",
        projectId: "wonderful-life-sound"
      };

      // Initialize Firebase Auth and Database
      firebase.initializeApp(firebaseConfig);
      const auth = firebase.auth();
      const db = firebase.database();

      // Check authentication on page load
      auth.onAuthStateChanged(async (user) => {
        if (!user) {
          // No user signed in, redirect to login
          window.location.href = '/admin/login';
        } else {
          console.log('User authenticated:', user.email);
          // User is signed in, set up real-time listeners
          setupRealtimeListeners();
        }
      });

      // ==========================================
      // REAL-TIME LISTENERS
      // ==========================================

      function setupRealtimeListeners() {
        console.log('Setting up real-time listeners...');

        // Listen to favorites
        db.ref('selections/favorites').on('value', (snapshot) => {
          const favorites = snapshot.val() || [];
          updateFavoritesUI(favorites);
          updateOverviewStats();
        });

        // Listen to ratings
        db.ref('selections/ratings').on('value', (snapshot) => {
          const ratings = snapshot.val() || {};
          updateRatingsUI(ratings);
          updateOverviewStats();
        });

        // Listen to notes
        db.ref('selections/notes').on('value', (snapshot) => {
          const notes = snapshot.val() || {};
          updateNotesUI(notes);
          updateOverviewStats();
        });

        // Listen to delete flags
        db.ref('selections/deleteFlags').on('value', (snapshot) => {
          const deleteFlags = snapshot.val() || {};
          updateDeleteFlagsUI(deleteFlags);
        });
      }

      // Update Overview stats in real-time
      function updateOverviewStats() {
        Promise.all([
          db.ref('selections/favorites').once('value'),
          db.ref('selections/ratings').once('value'),
          db.ref('selections/notes').once('value')
        ]).then(([favSnapshot, ratSnapshot, notesSnapshot]) => {
          const favorites = favSnapshot.val() || [];
          const ratings = ratSnapshot.val() || {};
          const notes = notesSnapshot.val() || {};

          // Update stat cards
          const favCountEl = document.querySelector('.stat-card:nth-child(1) .stat-value');
          const ratingCountEl = document.querySelector('.stat-card:nth-child(2) .stat-value');
          const notesCountEl = document.querySelector('.stat-card:nth-child(3) .stat-value');

          if (favCountEl) favCountEl.textContent = favorites.length;
          if (ratingCountEl) ratingCountEl.textContent = Object.keys(ratings).length;
          if (notesCountEl) {
            const noteCount = Object.values(notes).filter(n => n && n.trim().length > 0).length;
            notesCountEl.textContent = noteCount;
          }
        });
      }

