      // Save current tab state to localStorage
      function saveTabState() {
        const activeMainTab = document.querySelector('.main-tab.active');
        const activeSubTab = document.querySelector('.sub-tab.active');

        if (activeMainTab) {
          const mainTabButton = activeMainTab.getAttribute('onclick');
          const mainTabMatch = mainTabButton?.match(/switchMainTab\('([^']+)'\)/);
          if (mainTabMatch) {
            localStorage.setItem('adminActiveMainTab', mainTabMatch[1]);
          }
        }

        if (activeSubTab) {
          const subTabButton = activeSubTab.getAttribute('onclick');
          const subTabMatch = subTabButton?.match(/switchSubTab\('([^']+)',\s*'([^']+)'\)/);
          if (subTabMatch) {
            localStorage.setItem('adminActiveSubTab', subTabMatch[2]);
          }
        }
      }

