      const debouncedSaveDeleteFlag = debounce(saveDeleteFlag, 150);

      // Save individual note (debounced)
      let noteTimeouts = {};
      function saveNote(category, notes) {
        clearTimeout(noteTimeouts[category]);
        noteTimeouts[category] = setTimeout(() => {
          fetch('/api/selections/note', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
