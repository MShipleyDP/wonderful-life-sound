      // Rebuild Favorites Grid
      async function rebuildFavoritesGrid(favorites) {
        const favoritesGrid = document.getElementById('favoritesGrid');
        if (!favoritesGrid) return;

        if (favorites.length === 0) {
          favoritesGrid.innerHTML = '<p style="color: var(--color-text-muted); text-align: center; padding: var(--space-8);">No favorites yet.</p>';
          return;
        }

        // Fetch sound data to get full file info
        try {
          const response = await fetch('/admin/data');
          const data = await response.json();
          const soundData = data.soundData || {};

          let html = '';
          favorites.forEach(fav => {
            const category = soundData[fav.category];
            if (!category) return;

            const file = category.files?.find(f => {
              const fname = f.filename || f;
              return fname === fav.file;
            });

            if (file) {
              const filename = file.filename || file;
              const url = file.url || `${fav.category}/${filename}`;

              html += `
                <div class="sound-item" style="border-left-color: var(--color-success);">
                  <div class="sound-info">
                    <strong>${category.title} / ${filename}</strong>
                    ${url ? `
                      <audio class="admin-audio" controls preload="none">
                        <source src="${url}" type="audio/mpeg">
                      </audio>
                    ` : ''}
                  </div>
                  <button class="btn btn-danger" onclick="unfavoriteSound('${fav.category}', '${filename}')">Unfavorite</button>
